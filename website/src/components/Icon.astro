---
import { ArrowLeft, ArrowRight, ArrowUpRight, CodeXml, KeyRound, Menu, MessagesSquare, Plus, Rss, Send } from 'lucide-react';

// Lucide icons render to static SVG here. Lucide has no brand marks, so GitHub keeps its outline in the same style.
const icons = {
  arrow: ArrowRight,
  'arrow-left': ArrowLeft,
  external: ArrowUpRight,
  code: CodeXml,
  menu: Menu,
  plus: Plus,
  feed: Rss,
  conversation: MessagesSquare,
  account: KeyRound,
  publish: Send,
};
interface Props { name: keyof typeof icons | 'github'; size?: number; }
const { name, size = 20 } = Astro.props;
const LucideIcon = name === 'github' ? undefined : icons[name];
const github = 'M9 19c-4.3 1.3-4.3-2-6-2m12 5v-3.9a3.4 3.4 0 0 0-.9-2.7c3-.3 6.2-1.5 6.2-6.9A5.4 5.4 0 0 0 18.8 5a5 5 0 0 0-.1-3.5S17.5 1.2 15 3a13.4 13.4 0 0 0-7 0C5.5 1.2 4.3 1.5 4.3 1.5A5 5 0 0 0 4.2 5 5.4 5.4 0 0 0 2.7 8.6c0 5.4 3.2 6.6 6.2 6.9a3.4 3.4 0 0 0-.9 2.7V22';
---
{LucideIcon ? <LucideIcon size={size} /> : <svg class="lucide" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={github} /></svg>}
