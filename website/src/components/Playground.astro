---
import { Code } from 'astro:components';
const snippets = {
  hot: `import { useFeed } from "@bitsocial/bitsocial-react-hooks";\n\nfunction YourFeed({ communityName }) {\n  const { feed, hasMore, loadMore } = useFeed({\n    communities: [{ name: communityName }],\n    sortType: "hot",\n    postsPerPage: 10,\n  });\n\n  return (\n    <>\n      {feed.map(post => (\n        <article key={post.cid}>\n          <h2>{post.title}</h2>\n          <p>{post.content}</p>\n        </article>\n      ))}\n      {hasMore && (\n        <button onClick={() => void loadMore()}>\n          Load more\n        </button>\n      )}\n    </>\n  );\n}`,
  community: `import { useCommunity } from "@bitsocial/bitsocial-react-hooks";\n\nfunction YourCommunity({ communityName }) {\n  const community = useCommunity({\n    community: { name: communityName },\n  });\n\n  return (\n    <header>\n      <h1>{community.title}</h1>\n      <p>{community.description}</p>\n      {community.error && (\n        <p role="alert">{community.error.message}</p>\n      )}\n    </header>\n  );\n}`,
  thread: `import { useComment, useReplies }\n  from "@bitsocial/bitsocial-react-hooks";\n\nfunction YourThread({ commentCid }) {\n  const comment = useComment({ commentCid });\n  const { replies } = useReplies({ comment });\n\n  return (\n    <article>\n      <h1>{comment.title}</h1>\n      <p>{comment.content}</p>\n      {replies.map(reply => (\n        <p key={reply.cid}>{reply.content}</p>\n      ))}\n    </article>\n  );\n}`,
};
const examples = [
  { id: 'feed', label: 'A feed', hook: 'useFeed' },
  { id: 'community', label: 'A community', hook: 'useCommunity' },
  { id: 'thread', label: 'A conversation', hook: 'useReplies' },
];
---
<section id="playground" class="playground" aria-label="Interactive hook examples">
  <div class="playground-toolbar"><div class="example-tabs" aria-label="Choose an example">{examples.map(({ id, label }) => <button data-example={id} aria-pressed={id === 'feed'}>{label}</button>)}</div><span class="sample-badge"><span></span> Interactive preview</span></div>
  <div class="playground-body">
    <div class="example-code">
      <div class="pane-label"><span id="example-filename">YourFeed.jsx</span><span>React</span></div>
      <div data-snippet="feed" data-sort="hot"><Code code={snippets.hot} lang="jsx" themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} /></div>
      <div data-snippet="feed" data-sort="new" hidden><Code code={snippets.hot.replace('"hot"', '"new"')} lang="jsx" themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} /></div>
      <div data-snippet="community" hidden><Code code={snippets.community} lang="jsx" themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} /></div>
      <div data-snippet="thread" hidden><Code code={snippets.thread} lang="jsx" themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} /></div>
    </div>
    <div class="example-preview">
      <div class="pane-label"><span>Your app, your design</span><span>Sample data</span></div>
      <div data-preview="feed" class="feed-preview">
        <div class="mini-app-header"><div class="mini-avatar">b<span>✳</span></div><div><strong>The builders’ corner</strong><small>A place for things worth making.</small></div></div>
        <div class="feed-controls"><span>Community feed</span><div aria-label="Preview feed sort"><button data-sort-button="hot" aria-pressed="true">Hot</button><button data-sort-button="new" aria-pressed="false">New</button></div></div>
        <div id="preview-posts" aria-live="polite"></div>
        <button id="preview-load-more" class="load-more">Load more posts <span>↓</span></button>
      </div>
      <div data-preview="community" class="community-preview" hidden><div class="community-art"><img src="/logo.png" alt="" width="100" height="100" /></div><h3>The builders’ corner</h3><p>A place for things worth making. Share your work, ask questions, and build the next corner of the social web.</p><div class="community-details"><span>Community-owned</span><span>Open to new ideas</span></div><p class="preview-caption">One community. Any number of apps.</p></div>
      <div data-preview="thread" class="thread-preview" hidden><span class="post-category">A conversation</span><h3>What would you build if the network was already there?</h3><p>I've been thinking about a tiny forum for my local music scene. What’s your idea?</p><div class="sample-reply"><span class="person-avatar">M</span><div><strong>mira</strong><p>A reading club where we actually own the community.</p><div class="sample-reply nested"><span class="person-avatar blue">J</span><div><strong>jo</strong><p>I'd use that. Let’s build it.</p></div></div></div></div><div class="sample-reply"><span class="person-avatar">A</span><div><strong>alex</strong><p>A feed that lets me pick my own algorithm.</p></div></div></div>
    </div>
  </div>
  <div class="playground-footnote"><span>Real hook APIs. Simulated content. Nothing is published.</span><a id="example-doc-link" href="/docs/api/feeds-hooks/">Explore useFeed <span aria-hidden="true">↗</span></a></div>
</section>
<script>
  const posts = [
    { title: 'What would you build if the network was already there?', content: 'A small question for anyone with a big idea.', category: 'Discussion', author: 'mira', votes: 42, replies: 12 },
    { title: 'A little forum for the things you love.', content: 'I made a space for people who still make things by hand.', category: 'Show and tell', author: 'alex', votes: 28, replies: 8 },
    { title: 'Your interface. Your algorithms. Your rules.', content: 'Experimenting with a calmer kind of social app.', category: 'Work in progress', author: 'jo', votes: 17, replies: 4 },
  ];
  let example = 'feed';
  let sort = 'hot';
  let expanded = false;
  const container = document.querySelector('#preview-posts')!;
  const loadMore = document.querySelector<HTMLButtonElement>('#preview-load-more')!;
  function renderFeed() {
    container.replaceChildren();
    const items = sort === 'new' ? [...posts].reverse() : posts;
    for (const post of items.slice(0, expanded ? 3 : 2)) {
      const article = document.createElement('article');
      article.className = 'sample-post';
      const score = document.createElement('span');
      score.className = 'sample-score';
      score.textContent = `↑ ${post.votes}`;
      const content = document.createElement('div');
      const category = document.createElement('span');
      category.className = 'post-category';
      category.textContent = post.category;
      const title = document.createElement('h3');
      title.textContent = post.title;
      const summary = document.createElement('p');
      summary.textContent = post.content;
      const meta = document.createElement('small');
      meta.textContent = `${post.author} · ${post.replies} replies`;
      content.append(category, title, summary, meta);
      article.append(score, content);
      container.append(article);
    }
    loadMore.textContent = expanded ? 'All caught up' : 'Load more posts ↓';
    loadMore.disabled = expanded;
  }
  function updateExample() {
    document.querySelectorAll<HTMLElement>('[data-snippet]').forEach((el) => { el.hidden = el.dataset.snippet !== example || (example === 'feed' && el.dataset.sort !== sort); });
    document.querySelectorAll<HTMLElement>('[data-preview]').forEach((el) => { el.hidden = el.dataset.preview !== example; });
    document.querySelectorAll<HTMLElement>('[data-example]').forEach((el) => { el.setAttribute('aria-pressed', String(el.dataset.example === example)); });
    const labels = { feed: ['YourFeed.jsx', 'useFeed', 'feeds-hooks'], community: ['YourCommunity.jsx', 'useCommunity', 'communities-hooks'], thread: ['YourThread.jsx', 'useReplies', 'comments-hooks'] } as const;
    const [filename, hook, slug] = labels[example as keyof typeof labels];
    document.querySelector('#example-filename')!.textContent = filename;
    const link = document.querySelector<HTMLAnchorElement>('#example-doc-link')!;
    link.textContent = `Explore ${hook} ↗`;
    link.href = `/docs/api/${slug}/`;
  }
  document.querySelectorAll<HTMLButtonElement>('[data-example]').forEach((button) => button.addEventListener('click', () => { example = button.dataset.example!; updateExample(); }));
  document.querySelectorAll<HTMLButtonElement>('[data-sort-button]').forEach((button) => button.addEventListener('click', () => {
    sort = button.dataset.sortButton!;
    expanded = false;
    document.querySelectorAll<HTMLElement>('[data-sort-button]').forEach((el) => el.setAttribute('aria-pressed', String(el.dataset.sortButton === sort)));
    renderFeed(); updateExample();
  }));
  loadMore.addEventListener('click', () => { expanded = true; renderFeed(); });
  renderFeed();
</script>
