---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getDocs, groups, repoUrl } from '../../lib/docs';
export async function getStaticPaths() {
  return (await getDocs()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const allDocs = await getDocs();
const { Content, headings } = await render(entry);
const currentIndex = allDocs.findIndex((doc) => doc.id === entry.id);
const previous = allDocs[currentIndex - 1];
const next = allDocs[currentIndex + 1];
const toc = headings.filter((heading) => heading.depth <= 3);
---
<Base title={entry.data.title} description={entry.data.description} docs>
  <div class="docs-shell page-width">
    <aside class="docs-sidebar" aria-label="Documentation navigation">
      <details class="mobile-docs" open>
        <summary>Documentation <Icon name="menu" size={18} /></summary>
        <nav aria-label="Documentation">
          {groups.map((group) => <details class="nav-group" open={group !== 'Recipes' || entry.data.group === group}>
            <summary>{group}</summary>
            {allDocs.filter((doc) => doc.data.group === group).map((doc) => <a href={`/docs/${doc.id}/`} aria-current={entry.id === doc.id ? 'page' : undefined}>{doc.data.title.replace(/ Hooks$/, '').replace(/^\(Desktop only\) /, '')}</a>)}
          </details>)}
        </nav>
        <a class="protocol-link" href="https://docs.bitsocial.net">Protocol documentation <Icon name="external" size={13} /></a>
      </details>
    </aside>
    <main id="main" class="doc-main">
      <div class="doc-eyebrow"><span>{entry.data.group}</span><div><a href={`/docs/${entry.id}.md`} title="Read this page as Markdown">Markdown</a><a href={`${repoUrl}/blob/master/${entry.data.source}`} title="View this page's source">Source <Icon name="external" size={12} /></a></div></div>
      <h1>{entry.data.title}</h1>
      <p class="doc-description">{entry.data.description}</p>
      <div class="prose"><Content /></div>
      <div class="doc-pagination">
        {previous ? <a href={`/docs/${previous.id}/`}><small>Previous</small><span><Icon name="arrow-left" size={14} /> {previous.data.title}</span></a> : <span />}
        {next && <a href={`/docs/${next.id}/`}><small>Next</small><span>{next.data.title} <Icon name="arrow" size={14} /></span></a>}
      </div>
    </main>
    <aside class="on-this-page" aria-label="On this page">
      {toc.length > 0 && <><span>On this page</span><nav>{toc.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav></>}
      <div class="docs-help"><Icon name="code" size={22} /><p>Building with an agent?</p><a href="/docs/ai/">Get the AI docs <Icon name="arrow" size={13} /></a></div>
    </aside>
  </div>
</Base>
<script>
  // Native details keeps mobile navigation usable without a JS framework.
  const navigation = document.querySelector<HTMLDetailsElement>('.mobile-docs');
  if (navigation) {
    const mobile = window.matchMedia('(max-width: 800px)');
    const updateNavigation = () => { navigation.open = !mobile.matches; };
    updateNavigation();
    mobile.addEventListener('change', updateNavigation);
  }
</script>
