---
import Base from '../layouts/Base.astro';
import Playground from '../components/Playground.astro';
import Icon from '../components/Icon.astro';
import MeshGraphic from '../components/MeshGraphic';
import InstallCommand from '../components/InstallCommand';
import { packageVersion, repoUrl } from '../lib/docs';
---
<Base>
  <main id="main">
    <section class="hero-scene">
      <MeshGraphic client:visible />
      <div class="hero page-width">
      <a class="version-link" href={`${repoUrl}/releases`}><span class="blue-dot"></span> Bitsocial React Hooks <span class="version" data-package-version>v{packageVersion}</span><span aria-hidden="true">↗</span></a>
      <h1>Build your corner<br />of the internet.</h1>
      <p class="hero-description">A social network to build on. React hooks to make it yours.<br class="wide-break" /> Bring your interface. The communities are already here.</p>
      <div class="hero-actions"><a class="button primary" href="/docs/quickstart/">Start building <Icon name="arrow" size={18} /></a><a class="button secondary" href="/docs/api/feeds-hooks/">Explore the hooks <Icon name="code" size={18} /></a></div>
      <InstallCommand client:load />
      </div>
    </section>
    <div class="playground-wrap page-width"><Playground /></div>
    <section class="building-blocks page-width" aria-labelledby="blocks-title">
      <div class="section-intro"><h2 id="blocks-title">You bring the idea.<br />The hooks do the plumbing.</h2><p>Feeds, conversations, accounts, and publishing.<br />Compose what you need into something new.</p></div>
      <div class="feature-grid">
        <a href="/docs/api/feeds-hooks/" class="feature"><span class="feature-symbol" aria-hidden="true">≋</span><h3>A feed with your point of view</h3><p>Combine communities, choose a sort, and load the next page. You decide what discovery looks like.</p><code>useFeed <span>↗</span></code></a>
        <a href="/docs/api/comments-hooks/" class="feature"><span class="feature-symbol" aria-hidden="true">↳</span><h3>Conversations that connect</h3><p>Turn a post into a thread. Read comments and replies, with updates flowing into your UI.</p><code>useComment · useReplies <span>↗</span></code></a>
        <a href="/docs/api/accounts-hooks/" class="feature"><span class="feature-symbol" aria-hidden="true">◎</span><h3>Accounts people own</h3><p>Local accounts, portable keys, and subscriptions. Build an experience around people, not logins.</p><code>useAccount <span>↗</span></code></a>
        <a href="/docs/api/actions-hooks/" class="feature"><span class="feature-symbol" aria-hidden="true">↗</span><h3>Let people take part</h3><p>Publish, reply, and vote. Handle community challenges with explicit state and callbacks.</p><code>usePublishComment <span>↗</span></code></a>
      </div>
    </section>
    <section class="ecosystem page-width" aria-labelledby="ecosystem-title"><div><span class="section-kicker">One network, many possibilities</span><h2 id="ecosystem-title">The next social app<br />could be yours.</h2><p>Build a forum for a niche you care about. Try a different kind of feed. Give an existing community a better home.</p><p>Bitsocial is an open peer-to-peer network. Compatible apps can share communities and content, while competing on what makes them useful.</p><a class="text-link" href="https://bitsocial.net/#master-plan">Read the call to builders <Icon name="arrow" size={17} /></a></div><div class="ecosystem-links"><a href="https://5chan.app"><img class="app-icon" src="/apps/5chan.png" alt="" width="46" height="46" /><div><h3>5chan</h3><p>A peer-to-peer 4chan alternative.</p></div><span aria-hidden="true">↗</span></a><a href="https://seedit.app"><img class="app-icon" src="/apps/seedit.png" alt="" width="46" height="46" /><div><h3>Seedit</h3><p>A peer-to-peer Reddit alternative.</p></div><span aria-hidden="true">↗</span></a><a href="/docs/quickstart/" class="your-app"><div class="app-letter">+</div><div><h3>Your next project</h3><p>Start with a single component.</p></div><Icon name="arrow" /></a></div></section>
    <section class="ai-strip page-width"><div class="ai-mark" aria-hidden="true">{`{ }`}</div><div><h2>Bring your AI collaborator.</h2><p>The same docs, ready for your coding agent. Plain Markdown, a compact index, and the full reference.</p></div><a class="button secondary" href="/docs/ai/">Build with AI <Icon name="arrow" size={17} /></a></section>
  </main>
</Base>
